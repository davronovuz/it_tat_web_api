from django.contrib import admin
from .models import Course, Mentor, Portfolio, CourseLessonVideo, Registration, FeedbackMentor, FAQ, ProgramRequest, Technology

class FeedbackMentorAdmin(admin.ModelAdmin):
    list_display = ('full_name', 'mentor', 'video')


@admin.register(Course)
class CourseAdmin(admin.ModelAdmin):
    list_display = ('title', 'description', 'created_at')
    search_fields = ('title',)


@admin.register(Portfolio)
class PortfolioAdmin(admin.ModelAdmin):
    list_display = ('id', 'title', 'mentor')


@admin.register(Mentor)
class MentorAdmin(admin.ModelAdmin):
    list_display = ('name', 'experience')
    search_fields = ('name',)


@admin.register(Registration)
class RegistrationAdmin(admin.ModelAdmin):
    list_display = ('user', 'course', 'status')


@admin.register(FAQ)
class FAQAdmin(admin.ModelAdmin):
    list_display = ('question', 'answer')


@admin.register(FeedbackMentor)
class FeedbackMentorAdmin(admin.ModelAdmin):
    list_display = ('mentor', 'user', 'rating')


@admin.register(CourseLessonVideo)
class CourseLessonVideoAdmin(admin.ModelAdmin):
    list_display = ('title', 'course', 'video')


@admin.register(ProgramRequest)
class ProgramRequestAdmin(admin.ModelAdmin):
    list_display = ('user', 'course', 'status')
