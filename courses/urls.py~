from django.urls import path, include
from django.conf import settings
from django.conf.urls.static import static
from rest_framework.routers import DefaultRouter
from .views import TechnologyViewSet, CourseViewSet, PortfolioViewSet, MentorViewSet,\
    CourseLessonVideoViewSet, FeedbackMentorViewSet, RegistrationViewSet,FAQViewSet, ProgramRequestViewSet,HomeAPIView


router = DefaultRouter()
router.register('technologies', TechnologyViewSet, basename='technologies')
router.register('courses', CourseViewSet, basename='courses')
router.register('portfolios', PortfolioViewSet, basename='portfolios')
router.register('mentors', MentorViewSet, basename='mentors')
router.register('course_lesson_videos', CourseLessonVideoViewSet, basename='course_lesson_videos')
router.register('feedback_mentors', FeedbackMentorViewSet, basename='feedback_mentors')
router.register('registrations', RegistrationViewSet, basename='registrations')
router.register('faqs', FAQViewSet, basename='faqs')
router.register(r'program_requests', ProgramRequestViewSet, basename='program_requests')

urlpatterns = [
    path('', HomeAPIView.as_view(), name='home'),
    path('api/', include(router.urls)),
]