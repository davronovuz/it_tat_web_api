from rest_framework import viewsets
from .models import Course, Mentor, Portfolio, CourseLessonVideo, Registration, FeedbackMentor, FAQ, ProgramRequest, Technology
from .serializers import (
    CourseSerializer, MentorSerializer, PortfolioSerializer, CourseLessonVideoSerializer,
    RegistrationSerializer, FeedbackMentorSerializer, FAQSerializer, ProgramRequestSerializer, TechnologySerializer
)

class TechnologyViewSet(viewsets.ModelViewSet):
    queryset = Technology.objects.all()
    serializer_class = TechnologySerializer

class CourseViewSet(viewsets.ModelViewSet):
    queryset = Course.objects.all()
    serializer_class = CourseSerializer

class MentorViewSet(viewsets.ModelViewSet):
    queryset = Mentor.objects.all()
    serializer_class = MentorSerializer

class PortfolioViewSet(viewsets.ModelViewSet):
    queryset = Portfolio.objects.all()
    serializer_class = PortfolioSerializer

class CourseLessonVideoViewSet(viewsets.ModelViewSet):
    queryset = CourseLessonVideo.objects.all()
    serializer_class = CourseLessonVideoSerializer

class RegistrationViewSet(viewsets.ModelViewSet):
    queryset = Registration.objects.all()
    serializer_class = RegistrationSerializer

class FeedbackMentorViewSet(viewsets.ModelViewSet):
    queryset = FeedbackMentor.objects.all()
    serializer_class = FeedbackMentorSerializer

class FAQViewSet(viewsets.ModelViewSet):
    queryset = FAQ.objects.all()
    serializer_class = FAQSerializer

class ProgramRequestViewSet(viewsets.ModelViewSet):
    queryset = ProgramRequest.objects.all()
    serializer_class = ProgramRequestSerializer
    